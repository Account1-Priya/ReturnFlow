generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String
  role         String   @default("CUSTOMER")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  orders               Order[]
  returnRequests       ReturnRequest[]       @relation("CustomerReturns")
  reviewedReturns      ReturnRequest[]       @relation("ReviewedReturns")
  statusHistoryChanges ReturnStatusHistory[] @relation("StatusChanger")

  @@map("users")
}

model Product {
  id             Int      @id @default(autoincrement())
  sku            String   @unique
  name           String
  description    String
  category       String
  isFinalSale    Boolean  @default(false) @map("is_final_sale")
  unitPriceCents Int      @map("unit_price_cents")
  stock          Int      @default(100)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  orderItems OrderItem[]

  @@map("products")
}

model Order {
  id            Int       @id @default(autoincrement())
  customerId    Int       @map("customer_id")
  status        String    @default("PENDING")
  subtotalCents Int       @map("subtotal_cents")
  discountCents Int       @default(0) @map("discount_cents")
  shippingCents Int       @default(0) @map("shipping_cents")
  taxCents      Int       @default(0) @map("tax_cents")
  totalCents    Int       @map("total_cents")
  deliveredAt   DateTime? @map("delivered_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  customer       User            @relation(fields: [customerId], references: [id])
  items          OrderItem[]
  returnRequests ReturnRequest[]

  @@index([customerId])
  @@index([status])
  @@index([deliveredAt])
  @@map("orders")
}

model OrderItem {
  id             Int @id @default(autoincrement())
  orderId        Int @map("order_id")
  productId      Int @map("product_id")
  quantity       Int
  unitPriceCents Int @map("unit_price_cents")
  discountCents  Int @default(0) @map("discount_cents")
  taxCents       Int @default(0) @map("tax_cents")
  lineTotalCents Int @map("line_total_cents")

  order       Order        @relation(fields: [orderId], references: [id])
  product     Product      @relation(fields: [productId], references: [id])
  returnItems ReturnItem[]

  @@index([orderId])
  @@map("order_items")
}

model ReturnRequest {
  id              Int      @id @default(autoincrement())
  orderId         Int      @map("order_id")
  customerId      Int      @map("customer_id")
  reason          String
  comment         String?
  status          String   @default("SUBMITTED")
  reviewedById    Int?     @map("reviewed_by")
  rejectionReason String?  @map("rejection_reason")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  order         Order                 @relation(fields: [orderId], references: [id])
  customer      User                  @relation("CustomerReturns", fields: [customerId], references: [id])
  reviewedBy    User?                 @relation("ReviewedReturns", fields: [reviewedById], references: [id])
  returnItems   ReturnItem[]
  images        ReturnImage[]
  refund        Refund?
  statusHistory ReturnStatusHistory[]

  @@index([customerId])
  @@index([orderId])
  @@index([status])
  @@index([createdAt])
  @@map("return_requests")
}

model ReturnItem {
  id                  Int @id @default(autoincrement())
  returnRequestId     Int @map("return_request_id")
  orderItemId         Int @map("order_item_id")
  quantityReturned    Int @map("quantity_returned")
  itemRefundCents     Int @map("item_refund_cents")
  taxRefundCents      Int @default(0) @map("tax_refund_cents")
  restockingFeeCents  Int @default(0) @map("restocking_fee_cents")
  shippingRefundCents Int @default(0) @map("shipping_refund_cents")
  totalRefundCents    Int @map("total_refund_cents")

  returnRequest ReturnRequest @relation(fields: [returnRequestId], references: [id])
  orderItem     OrderItem     @relation(fields: [orderItemId], references: [id])

  @@index([returnRequestId])
  @@index([orderItemId])
  @@map("return_items")
}

model ReturnImage {
  id              Int      @id @default(autoincrement())
  returnRequestId Int      @map("return_request_id")
  fileName        String   @map("file_name")
  filePath        String   @map("file_path")
  mimeType        String   @map("mime_type")
  fileSizeBytes   Int      @map("file_size_bytes")
  uploadedAt      DateTime @default(now()) @map("uploaded_at")

  returnRequest ReturnRequest @relation(fields: [returnRequestId], references: [id])

  @@index([returnRequestId])
  @@map("return_images")
}

model Refund {
  id               Int       @id @default(autoincrement())
  returnRequestId  Int       @unique @map("return_request_id")
  totalRefundCents Int       @map("total_refund_cents")
  status           String    @default("PENDING")
  gatewayRef       String?   @map("gateway_ref")
  failureReason    String?   @map("failure_reason")
  initiatedAt      DateTime  @default(now()) @map("initiated_at")
  completedAt      DateTime? @map("completed_at")

  returnRequest ReturnRequest @relation(fields: [returnRequestId], references: [id])

  @@map("refunds")
}

model ReturnStatusHistory {
  id              Int      @id @default(autoincrement())
  returnRequestId Int      @map("return_request_id")
  changedById     Int      @map("changed_by")
  fromStatus      String?  @map("from_status")
  toStatus        String   @map("to_status")
  note            String?
  changedAt       DateTime @default(now()) @map("changed_at")

  returnRequest ReturnRequest @relation(fields: [returnRequestId], references: [id])
  changedBy     User          @relation("StatusChanger", fields: [changedById], references: [id])

  @@index([returnRequestId])
  @@index([changedAt])
  @@map("return_status_history")
}

