# ==============================================================================
# ReturnFlow Environment Configuration Template
# ==============================================================================

# Node Environment ('development' | 'production' | 'test')
NODE_ENV=development

# Server Port
PORT=3001
PORT_FRONTEND=5173

# Database Connection (Supabase PostgreSQL / Local Postgres)
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres?connection_limit=5"

# SQLite Fallback (if testing offline without PostgreSQL)
# DATABASE_URL="file:./dev.db"

# JWT Authentication Secret
JWT_SECRET=returnflow_super_secret_jwt_key_2026

# Seeded Bugs Toggle (Set to true to inject intentional edge-case bugs for QA suites)
ENABLE_SEEDED_BUGS=false

# File Upload Max Size in Bytes (default 5MB = 5242880)
MAX_FILE_SIZE_BYTES=5242880
MAX_FILES_COUNT=5

